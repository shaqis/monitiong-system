# PostgreSQL
# Keep the password URL-safe. Compose inserts it into DATABASE_URL.
POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime
POSTGRES_DB=uptime
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Initial admin account, seeded when the users table is empty.
# This value is a local placeholder. Change it before any non-loopback deployment.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-now
FIRST_ADMIN_NAME=Admin
