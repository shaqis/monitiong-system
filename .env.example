# PostgreSQL
# Keep the password URL-safe. Compose inserts it into DATABASE_URL.
POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime
POSTGRES_DB=uptime
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# JSON list. Must exactly match the browser origin of the frontend service.
CORS_ORIGINS=["http://localhost:3000"]
# Set a strong secret before starting. Compose refuses to start while this is empty.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=access_token
# Must be true anywhere other than localhost, since HTTPS is required for secure cookies.
COOKIE_SECURE=false

# Initial admin account, seeded when the users table is empty.
# Set a strong password before starting. Compose refuses to start while this is empty.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Admin

# Frontend
FRONTEND_PORT=3000
# The browser calls the API directly. Keep this origin reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# The Next.js server calls the API over the Compose network.
API_INTERNAL_URL=http://backend:8000/api/v1

# Monitoring scheduler and connection pool
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=10
SCHEDULER_RETRY_SECONDS=5
MAX_CONCURRENT_CHECKS=20
PROBE_USER_AGENT=UptimeMonitor/1.0
SSL_INSPECT_TIMEOUT_SECONDS=5
# DB_POOL_SIZE must be at least MAX_CONCURRENT_CHECKS.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
